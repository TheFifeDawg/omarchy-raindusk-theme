# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#3a3c40"

# Main text color
theme[main_fg]="#e8e2d6"

# Title color for boxes
theme[title]="#e8e2d6"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#d4a06a"

# Background color of selected item in processes box
theme[selected_bg]="#4a4c50"

# Foreground color of selected item in processes box
theme[selected_fg]="#d4a06a"

# Color of inactive/disabled text
theme[inactive_fg]="#b2aea4"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#f0ebe2"

# Background color of the percentage meters
theme[meter_bg]="#4a4c50"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#f0ebe2"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#8a6a70"
theme[mem_box]="#7a8a6a"
theme[net_box]="#c45c52"
theme[proc_box]="#d4a06a"

# Box divider line and small boxes line color
theme[div_line]="#b2aea4"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#7a8a6a"
theme[temp_mid]="#d4a06a"
theme[temp_end]="#c45c52"

# CPU graph colors (Teal -> Blue -> Magenta)
theme[cpu_start]="#6a8a8a"
theme[cpu_mid]="#5a6a7a"
theme[cpu_end]="#8a6a70"

# Mem/Disk free meter
theme[free_start]="#8a6a70"
theme[free_mid]="#5a6a7a"
theme[free_end]="#6a8a8a"

# Mem/Disk cached meter
theme[cached_start]="#5a6a7a"
theme[cached_mid]="#6a8a8a"
theme[cached_end]="#8a6a70"

# Mem/Disk available meter
theme[available_start]="#d4a06a"
theme[available_mid]="#c45c52"
theme[available_end]="#c45c52"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#7a8a6a"
theme[used_mid]="#6a8a8a"
theme[used_end]="#5a6a7a"

# Download graph colors
theme[download_start]="#d4a06a"
theme[download_mid]="#c45c52"
theme[download_end]="#c45c52"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#7a8a6a"
theme[upload_mid]="#6a8a8a"
theme[upload_end]="#5a6a7a"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#6a8a8a"
theme[process_mid]="#5a6a7a"
theme[process_end]="#8a6a70"

# Graph gradient colors (spectrum shades from background to foreground)
theme[gradient_color_0]="#3a3c40"
theme[gradient_color_1]="#484a4e"
theme[gradient_color_2]="#4a4c50"
theme[gradient_color_3]="#b2aea4"
theme[gradient_color_4]="#b2aea4"
theme[gradient_color_5]="#e8e2d6"
theme[gradient_color_6]="#f0ebe2"
theme[gradient_color_7]="#f4efe6"
